# The app's own settings and API keys (API + worker). `./generate-env.sh` fills the secrets.
# Keep this file private (chmod 600). Leave an integration empty until you set it up:
# the dashboard shows it as "not configured" and never pretends it works.
LOG_LEVEL=info
SESSION_SECRET=
# Back this up somewhere safe, separately from the database backups: without it,
# stored Google/Canva tokens can't be decrypted (you'd have to reconnect them).
ACC_ENCRYPTION_KEY=

# ── Models ── console.anthropic.com
ANTHROPIC_API_KEY=
DEFAULT_MODEL_PROVIDER=anthropic
DEFAULT_MODEL=claude-opus-5

# ── Free local models (Ollama) ── ollama.com → install, then: ollama pull qwen3:8b
# To use it instead of Claude set DEFAULT_MODEL_PROVIDER=ollama. Ollama runs on this computer,
# so from inside Docker its address is host.docker.internal. No key and no cost, but slower
# and less reliable than Claude; a laptop with 16 GB RAM handles an 8B model.
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen3:8b
OLLAMA_NUM_CTX=16384
OLLAMA_TIMEOUT_SECONDS=600
# true lets thinking models (qwen3) reason before answering: better answers, much slower.
OLLAMA_THINK=false

# ── WhatsApp Cloud API ── Meta for Developers → your app → WhatsApp
# Webhook URL to register: https://<your domain>/api/webhooks/whatsapp
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_AUTO_TRIAGE=true
WHATSAPP_TRIAGE_DELAY_SECONDS=45

# ── Google Workspace / Canva ── redirect URL: https://<your domain>/api/integrations/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=

# ── Meta Ads (read-only, ads_read) ──
META_ADS_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# ── Research and knowledge ──
BRAVE_API_KEY=
TAVILY_API_KEY=
VOYAGE_API_KEY=

# ── Email (invites and password-reset links) ──
# Any SMTP provider: Gmail (app password), Zoho, Brevo, Resend, your host's mail.
#   smtps://user:password@smtp.gmail.com:465   or   smtp://user:password@host:587 (STARTTLS)
# Leave empty to use temporary passwords only. In development with ACC_ENABLE_MOCKS=true,
# emails are written to data/outbox/ instead of being sent.
SMTP_URL=
EMAIL_FROM=

# ── Optional ──
GITHUB_TOKEN=

# ── Limits (production defaults) ──
RATE_LIMIT_PER_MINUTE=300
LOGIN_IP_LIMIT=30
