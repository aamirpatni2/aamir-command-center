# ─── Core ──────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
API_HOST=0.0.0.0
API_PORT=4000
# Comma-separated list of allowed browser origins (the web dashboard)
WEB_ORIGINS=http://localhost:5173

# ─── Database / Redis ─────────────────────────────────
DATABASE_URL=postgres://acc:acc_dev_password@localhost:5432/acc_dev
# Used only by the test suite
TEST_DATABASE_URL=postgres://acc:acc_dev_password@localhost:5432/acc_test
REDIS_URL=redis://localhost:6379

# ─── Security ─────────────────────────────────────────
# 32+ random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=change-me-generate-a-random-value
ACC_ENCRYPTION_KEY=change-me-generate-a-random-value
SESSION_TTL_DAYS=7
SESSION_ABSOLUTE_TTL_DAYS=30

# Owner bootstrap (used once by `pnpm db:create-owner`, then remove from .env)
OWNER_EMAIL=
OWNER_NAME=
OWNER_PASSWORD=

# ─── Models (Milestone 3) ─────────────────────────────
# Required for real agent output (Milestone 3+). Get one at console.anthropic.com
ANTHROPIC_API_KEY=
DEFAULT_MODEL_PROVIDER=anthropic
DEFAULT_MODEL=claude-opus-5
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=

# ─── Integrations (later milestones; leave empty until configured) ──
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
BRAVE_API_KEY=
TAVILY_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
META_ADS_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
NOTION_TOKEN=

# Development/test only: allow clearly-labelled mock adapters
ACC_ENABLE_MOCKS=false
