# ─── Core ──────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
API_HOST=0.0.0.0
API_PORT=4000
# Comma-separated list of allowed browser origins (the web dashboard)
WEB_ORIGINS=http://localhost:5173

# ─── Database / Redis ─────────────────────────────────
DATABASE_URL=postgres://acc:acc_dev_password@localhost:5432/acc_dev
# Used only by the test suite
TEST_DATABASE_URL=postgres://acc:acc_dev_password@localhost:5432/acc_test
REDIS_URL=redis://localhost:6379

# ─── Security ─────────────────────────────────────────
# 32+ random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=change-me-generate-a-random-value
ACC_ENCRYPTION_KEY=change-me-generate-a-random-value
SESSION_TTL_DAYS=7
SESSION_ABSOLUTE_TTL_DAYS=30

# Owner bootstrap (used once by `pnpm db:create-owner`, then remove from .env)
OWNER_EMAIL=
OWNER_NAME=
OWNER_PASSWORD=

# ─── Models (Milestone 3) ─────────────────────────────
# Required for real agent output (Milestone 3+). Get one at console.anthropic.com
ANTHROPIC_API_KEY=
DEFAULT_MODEL_PROVIDER=anthropic
DEFAULT_MODEL=claude-opus-5
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=

# ─── Integrations (later milestones; leave empty until configured) ──
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v21.0
# Run the WhatsApp Agent on new inbound messages (it drafts; sending always needs approval)
WHATSAPP_AUTO_TRIAGE=true
WHATSAPP_TRIAGE_DELAY_SECONDS=45
# Web research (Milestone 8): one of these. Brave: api-dashboard.search.brave.com · Tavily: app.tavily.com
# ── Integrations (Milestone 11) ─────────────────────────────────────
# Public URL of the dashboard. Register <PUBLIC_URL>/api/integrations/oauth/callback
# as the redirect URL in the Google and Canva developer consoles.
PUBLIC_URL=http://localhost:5173
# Google Cloud Console → Credentials → OAuth client ID (Web). Enable Calendar, Drive, Gmail APIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Canva Developers → Your integrations (Connect API).
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
# Optional: fine-grained, read-only GitHub token for the GitHub MCP server (mcp.config.json).
GITHUB_TOKEN=
# Optional: path to a different MCP server config file.
# MCP_CONFIG=mcp.config.json

# Meta Business → System user with ads_read only (never ads_management). Account id with or without "act_".
META_ADS_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

BRAVE_API_KEY=
TAVILY_API_KEY=
# Semantic knowledge search (optional; without it, full-text search is used). dash.voyageai.com
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-3.5
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
META_ADS_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
NOTION_TOKEN=

# Development/test only: allow clearly-labelled mock adapters
ACC_ENABLE_MOCKS=false
