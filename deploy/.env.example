# Stack settings for docker compose (never passed to the app). `./generate-env.sh` writes this.
# Keep this file private (chmod 600).
SITE_ADDRESS=command.example.com
PUBLIC_URL=https://command.example.com
# Hex only (openssl rand -hex 24): they go into connection URLs.
POSTGRES_PASSWORD=
APP_DB_ROLE=acc_app
APP_DB_PASSWORD=
BACKUP_KEEP_DAYS=14
BACKUP_AT=02:30
# HTTP_PORT=80
# HTTPS_PORT=443
